+/*
+ * foc_ntc.h -- NTC 温度采样 + 过温保护 (PA3 / ADC1_IN4)
+ * ===========================================================================
+ * 分工:
+ *   foc_ntc_update()          : 1kHz 任务里调 (foc_loop). 一阶滤波 + Beta 公式
+ *                               换算 + 有效性判定 (可含浮点, 不在中断里)
+ *   foc_ntc_check_trip_isr()  : 10kHz 硬件节拍里调 (foc_mode_current_isr).
+ *                               纯整数比较 + 去抖, 无浮点、无 RTOS API
+ *   foc_ntc_over_temp()       : 任务里调, 启动前的互锁 (FAULT 后要降温才能再启动)
+ *
+ * 为什么保护要放在 10kHz: 与过流保护同一条路径, 采样/判定在硬件节拍上,
+ *   最坏 100µs 就能关掉六路输出; 放 1ms 任务里最坏会晚 1ms —— 对"后级兜底"
+ *   够用, 但同路径更省事也更一致。
+ */
+#ifndef FOC_NTC_H
+#define FOC_NTC_H
+
+#include <stdint.h>
+
+/* 1kHz 任务里调: 取 AUX 通道原始值 -> 滤波 -> 温度。无阻塞, 可重复调。 */
+void foc_ntc_update(void);
+
+/* 最近一次换算出的温度 (单位 0.1°C); 读数无效时返回 FOC_NTC_TEMP_INVALID */
+#define FOC_NTC_TEMP_INVALID  ((int32_t)0x7FFFFFFF)
+int32_t foc_ntc_temp_c_x10(void);
+uint32_t foc_ntc_updated_us(void);
+
+/* 读数是否有效 (1 = 有效)。无效 = 开路/短路/超范围。 */
+int foc_ntc_valid(void);
+
+/* 诊断: 滤波后的原始码 / 分压点电压(mV) / 累计跳闸次数 */
+uint16_t foc_ntc_raw(void);
+uint32_t foc_ntc_trips(void);
+
+/* ★10kHz 中断里调: 过温(或读数无效且配置为失效安全)并持续去抖时间到 -> 返回 1。
+ *   返回 1 时调用方必须立刻关输出 (foc_motor_emergency_stop)。
+ *   纯整数/计数器操作, 中断安全。 */
+int foc_ntc_check_trip_isr(void);
+
+/* ★任务里调: 启动互锁。温度 ≥ FOC_NTC_CLEAR_C_X10 或读数无效(失效安全) -> 返回 1
+ *   (调用方应拒绝启动)。滞回: 跳闸在 TRIP, 允许重启在 CLEAR, 两者之间保持现状。 */
+int foc_ntc_over_temp(void);
+
+#endif /* FOC_NTC_H */
