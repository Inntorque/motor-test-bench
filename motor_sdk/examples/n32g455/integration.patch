+    if (ok != 0u)
+    {
+        /* Beta 公式: 1/T = 1/T25 + ln(R/R25)/BETA   (T: K) */
+        inv_t = (1.0f / 298.15f) + (logf(r / (float)FOC_NTC_R25_OHM) / (float)FOC_NTC_BETA);
+        if (inv_t <= 0.0f)
+        {
+            ok = 0u;
+        }
+        else
+        {
+            tc = (1.0f / inv_t) - 273.15f;
+            if ((tc < (float)FOC_NTC_TEMP_MIN_C) || (tc > (float)FOC_NTC_TEMP_MAX_C))
+            {
+                ok = 0u;
+            }
+            else
+            {
+                s_temp_x10 = (int32_t)lroundf(tc * 10.0f);
+                g_ntc_temp_x10 = s_temp_x10;
+            }
+        }
+    }
+
+    s_updated_us=foc_tick_micros();
+    __DMB();
+    s_valid        = ok;  /* publish the temperature/valid result to TIM3 ISR */
+    g_ntc_valid    = ok;
+    if (ok == 0u)
+    {
+        g_ntc_temp_x10 = FOC_NTC_TEMP_INVALID;
+    }
+}
+
+int foc_ntc_check_trip_isr(void)
+{
+    int hot;
+
+    /* 还没量过 -> 不判 (避免上电瞬间误跳闸); 量过之后: 超温 或 读数无效(可配) */
+    if (s_primed == 0u)
+    {
+        return 0;
+    }
+    if (s_valid != 0u)
+    {
+        hot = (s_temp_x10 >= (int32_t)FOC_NTC_TRIP_C_X10) ? 1 : 0;
+    }
+    else
+    {
+        hot = (FOC_NTC_TRIP_ON_INVALID != 0) ? 1 : 0;
+    }
+
+    if (hot != 0)
+    {
+        uint32_t now = foc_tick_millis();
+
+        if (s_otp_ms == 0u)
+        {
+            s_otp_ms = (now == 0u) ? 1u : now;
+        }
+        else if ((now - s_otp_ms) >= FOC_NTC_DEBOUNCE_MS)
+        {
+            s_otp_ms = 0u;
+            s_trips++;
+            g_ntc_trips = s_trips;
+            return 1;
+        }
+    }
+    else
+    {
+        s_otp_ms = 0u;
+    }
+    return 0;
+}
+
+int foc_ntc_over_temp(void)
+{
+    if (s_primed == 0u)
+    {
+        return 0;   /* 还没量过: 不拦启动 */
+    }
+    if (s_valid == 0u)
+    {
+        return (FOC_NTC_TRIP_ON_INVALID != 0) ? 1 : 0;
+    }
+    return (s_temp_x10 >= (int32_t)FOC_NTC_CLEAR_C_X10) ? 1 : 0;
+}
+
+int foc_ntc_valid(void)
+{
+    return (s_valid != 0u) ? 1 : 0;
+}
+
+int32_t foc_ntc_temp_c_x10(void)
+{
+    if ((s_primed == 0u) || (s_valid == 0u))
+    {
+        return FOC_NTC_TEMP_INVALID;
+    }
+    return s_temp_x10;
+}
+
+uint16_t foc_ntc_raw(void)
+{
+    return (uint16_t)s_raw_filt;
+}
+
+uint32_t foc_ntc_trips(void)
+{
+    return s_trips;
+}
+
+#else  /* FOC_NTC_ENABLE == 0: 完全不参与, 全部返回"无温度信息" */
+
+volatile uint32_t g_ntc_disabled;
+
+void foc_ntc_update(void)                 { }
+int  foc_ntc_check_trip_isr(void)         { return 0; }
+int  foc_ntc_over_temp(void)              { return 0; }
+int  foc_ntc_valid(void)                  { return 0; }
+int32_t foc_ntc_temp_c_x10(void)          { return FOC_NTC_TEMP_INVALID; }
+uint16_t foc_ntc_raw(void)                { return 0u; }
+uint32_t foc_ntc_trips(void)              { return 0u; }
+
+#endif /* FOC_NTC_ENABLE */
