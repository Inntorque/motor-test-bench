+/*
+ * src/main.c -- CAN-OTA 应用固件 (示例骨架)
+ * ---------------------------------------------------------------------------
+ * 位置: Slot A (0x08008000) 或 Slot B (0x08043000), 同一份源码编两个地址版本。
+ *
+ * 这里的结构就是以后放 FOC 代码的位置:
+ *   1. ota_app_early_init()  把向量表指回自己 (必须第一行)
+ *   2. 开看门狗            卡死也能自动复位 -> try_left 递减 -> 回滚
+ *   3. 初始化外设
+ *   4. 外设自检
+ *   5. ota_confirm()        签字: 新固件转正 (★阶段2 起改由 RTOS 启动任务做, 见 main_rtos.c)
+ *   6. 主循环               FOC 环 + ota_proto_poll() (后台升级, 不中断业务)
+ *
+ * ⚠ ota_proto_poll() 必须被频繁调用 (主循环每圈一次)。收到镜像数据时
+ *   上位机会连续发帧, 调用间隔太长会丢帧 (丢了会自动重传, 只是变慢)。
+ */
+#include "ota_layout.h"
+#include "ota_can.h"
+#include "motor_bench_port.h"
+#include "ota_proto.h"
+#include "ota_slot.h"
+#include "ota_params.h"
+#include "foc.h"       /* FOC 应用层: 采样/遥测/主循环业务 (foc/foc.c, foc/foc_adc.c) */
+
+#include "n32g45x.h"
+#include "n32g45x_dbg.h"
+
+/* ★RTOS 阶段1: 由 src/main_rtos.c 提供 —— 创建静态任务并启动调度器(不返回)。
+ *   调用点必须在 ota_app_early_init/外设自检 完成之后 (签字已移到启动任务)。 */
+void foc_rtos_start(void);
+
+/* ★阶段2: 统一紧急出口 (src/main_rtos.c) —— 关功率输出 + 存故障码 + 受控复位 */
+void foc_panic_reset(uint32_t code);
+
+/* ------------------------------------------------------------------ */
+/* 给 SWD / make alive 看的诊断变量                                     */
+/* g_alive 是原来空工程就有的计数器, 保持不动                            */
+/* ------------------------------------------------------------------ */
+volatile uint32_t g_alive = 0xA5A50000u;
+volatile uint32_t g_ota_state;
+volatile uint32_t g_ota_slot;
+volatile uint32_t g_ota_image_size;
+volatile uint32_t g_ota_confirm_rc;
+volatile uint32_t g_ota_commands;
+volatile uint32_t g_ota_rx_bytes;
+volatile uint32_t g_ota_last_error;
+volatile uint32_t g_ota_can_rx;
+volatile uint32_t g_ota_can_other;
+volatile uint32_t g_ota_can_txfail;
+volatile uint32_t g_ota_can_rc;
+volatile uint32_t g_ota_pclk1;
+volatile uint32_t g_ota_presc;
+volatile uint32_t g_ota_tq;
+volatile uint32_t g_foc_init_rc; /* foc_init() 返回值: 0 = 自检通过 */
+
+/* ------------------------------------------------------------------ */
+/* 异常处理: ★阶段2 统一走 foc_panic_reset() —— 先关功率输出再复位,      */
+/*   不留空循环 (原来只复位不关输出, 故障复位瞬间功率级仍可能带输出)      */
+/*   Bootloader 会把 try_left 减一, 试满就回滚到旧固件 -> "永不砖"        */
+/* ------------------------------------------------------------------ */
+void HardFault_Handler(void)
+{
+    foc_panic_reset(0xF1000001u);
+}
+
+void MemManage_Handler(void)
+{
+    foc_panic_reset(0xF2000001u);
+}
+
+void BusFault_Handler(void)
+{
+    foc_panic_reset(0xF3000001u);
+}
+
+void UsageFault_Handler(void)
+{
+    foc_panic_reset(0xF4000001u);
+}
+
+/* ------------------------------------------------------------------ */
+/* 独立看门狗: LSI 约 40kHz / 64 = 625Hz, 重装 0xFFF => 约 6.5s          */
+/* 目的是"新固件能启动但跑飞/卡死"也能自动回滚, 而不是永远躺在那儿        */
+/*                                                                     */
+/* ⚠ 必须同时打开 DBG_IWDG_STOP (调试冻结):                             */
+/*   IWDG 由 LSI 驱动, 内核被调试器 halt 时它照样在数。没有这个冻结位,   */
+/*   调试器一 halt, 6.5 秒后看门狗就把芯片复位 —— 表现为 SWD "时好时坏"  */
+/*   (pyOCD 报 Transfer fault while initing board / 烧录偶发失败)。      */
+/* ------------------------------------------------------------------ */
+static void iwdg_init(void)
+{
+    IWDG_WriteConfig(IWDG_WRITE_ENABLE);
+    IWDG_SetPrescalerDiv(IWDG_PRESCALER_DIV64);
+    IWDG_CntReload(0x0FFFu);
+    IWDG_ReloadKey();
+    IWDG_Enable();
+
+    /* 调试器 halt 住内核时冻结 IWDG, 否则会周期性复位, 没法调试/烧录 */
+    DBG_ConfigPeriph(DBG_IWDG_STOP, ENABLE);
+}
+
+/* ==================================================================== */
+/*  ★★★ FOC 代码在 foc/ 目录 ★★★                                      */
+/*                                                                      */
+/*  foc_init(): 上电自检 (ADC 三相电流采样 + 零流偏置校准 + 注册遥测源)   */
+/*              返回非 0 = 硬故障 -> 不签字 -> Bootloader 自动回滚旧版本  */
+/*  foc_loop(): 每圈调用: 采样快照 + 遥测上报 (见 foc/foc.c)             */
+/* ==================================================================== */
+
+int main(void)
+{
+    /* ① 向量表指回自己 (SystemInit 会把它设成 0x08000000) */
+    ota_app_early_init();
+
+    /* ====================================================================
+     * ★★★ 必须重新打开全局中断 ★★★
+     *   Bootloader 在 ota_jump_to_slot() (ota/ota_slot.c:116) 里调了
+     *   __disable_irq() 才跳转到 App, 而 App 里原本没有任何地方重新打开 ——
+     *   也就是说 PRIMASK 一直是关的, **App 里所有中断都不会响应**。
+     *   (这也解释了为什么这个工程之前全靠轮询: CAN/ADC/看门狗都不需要中断,
+     *    而任何中断驱动的东西 —— 比如换向节拍定时器 —— 会完全没反应。)
+     *
+     *   实测症状: 六步换向的状态机卡在"自举预充"不动, 因为节拍中断没进来;
+     *             但 CAN 查询/遥测一切正常, 看起来"像死机又不像死机"。
+     * ==================================================================== */
+    __enable_irq();
+
+    /* ② 先开狗: 后面任何一步卡死都会被复位并触发回滚 */
+    iwdg_init();
+
+    /* ③ 外设初始化 */
+    g_ota_can_rc = (uint32_t)ota_can_init(OTA_CAN_BAUD_DEFAULT, OTA_CAN_NODE_DEFAULT);
+    ota_proto_init(OTA_ROLE_APP);
+    ota_params_init();  /* 从参数页加载 FOC 参数(失败则用默认值) */
+
+    g_ota_slot       = ota_self_slot();
+    g_ota_image_size = ota_image_size();
+    g_ota_pclk1      = ota_can_pclk1();
+    g_ota_presc      = ota_can_prescaler();
+    g_ota_tq         = ota_can_tq_total();
+
+    /* ④ 自检
+     *    foc_init() 里做: ADC 三相电流采样初始化 + 零流偏置校准 (+ 以后加编码器/栅驱)。
+     *    自检不过的处理分两种情况 (ota_is_pending_self 的注释里有完整理由):
+     *      - 刚 OTA 进来的新固件 (pending): 不签字 + 不喂狗 -> 看门狗复位
+     *        -> Bootloader 把 try_left 减一 -> 试满 OTA_TRY_MAX 次自动回滚 (有救)
+     *      - SWD 直烧的活动槽固件: 回滚机制不生效, 再复位就是死循环且 CAN 不响应。
+     *        这时选择"带病运行", 保住 CAN/OTA 这条救援通道, 故障码从诊断量看。 */
+    IWDG_ReloadKey();
+    {
+        int rc = foc_init();
+
+        ota_proto_set_foc_init_rc(rc); /* 上报给 GET_FOC_STAT, 无 SWD 也能看 */
+        g_foc_init_rc = (uint32_t)rc;
+        if ((rc != 0) && (ota_is_pending_self() != 0))
+        {
+            /* ★阶段2: 自检失败 + 自己是 pending 镜像 -> 受控复位(先关输出),
+             *   bootloader 会把 try_left 减一, 试满即回滚。
+             *   原来是 for(;;) 等看门狗, 白等约 6.5 秒且属于空转。 */
+            foc_panic_reset(0xF5000001u);
+        }
+    }
+
+    motor_bench_init();
+
+    /* ⑤ 签字确认: ★阶段2 改为【延迟到 RTOS 启动任务里做】——
+     *   见 src/main_rtos.c 的 task_startup()。
+     *   原来在这里(调度器起来之前)就签字: 于是"启动后立刻挂死"的坏镜像
+     *   也会被转正, 只有 IWDG 能救。现在只有"业务循环 + ADC + CAN 在
+     *   观察窗内都真的在推进"才 ota_confirm(); 否则不签字, 由 bootloader
+     *   按 try_left 回滚 (方案第二节「阶段 2」第 2 条)。 */
+
+    /* ⑥ ★RTOS 阶段1: 原主循环体抽成 foc_app_tick_once(), 由 poll 任务周期调用;
+     *    IWDG 不再在这里无条件喂 —— 改由 health 任务确认进度后才喂 (方案要求)。
+     *    20kHz PWM / 10kHz 换向节拍仍由 TIM1/TIM3 硬件负责, 与调度无关。
+     *    ⚠ 本阶段不要用这个镜像做 OTA 大块传输 (见 main_rtos.c 头部说明)。 */
+    foc_rtos_start();
+
+    /* 调度器只在初始化失败时才返回: 受控复位 (不做空转) */
+    NVIC_SystemReset();
+}
+
+/* poll 任务每轮调一次: 与原来的主循环体逐行等价, 功能不丢 */
+void foc_app_tick_once(void)
+{
+    g_alive++;
+
+    foc_loop();             /* ← 你的 FOC 代码 */
+    ota_proto_foc_tick();   /* 业务循环计数(可通过 CAN 读出来验证在跑) */
+
+    motor_bench_poll();
+    ota_proto_poll();
+
+    g_ota_state     = (uint32_t)(ota_proto_rx_active() ? OTA_STATE_RECEIVING : OTA_STATE_APP);
+    g_ota_commands  = ota_proto_commands();
+    g_ota_rx_bytes  = ota_proto_rx_bytes();
+    g_ota_last_error = ota_proto_last_error();
+    g_ota_can_rx    = ota_can_rx_frames();
+    g_ota_can_other = ota_can_rx_other();
+    g_ota_can_txfail = ota_can_tx_fail();
+}
+
+/* health 任务用它判断"业务是否真的在推进" */
+uint32_t foc_app_alive(void)
+{
+    return (uint32_t)g_alive;
+}
