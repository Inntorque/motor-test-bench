+/*
+ * ota_can.c -- CAN2 (PB12/PB13) 初始化与轮询收发
+ */
+#include "ota_can.h"
+#include "motor_bench_port.h"
+#include "ota_layout.h"
+#include "ota_params.h"
+
+#include "n32g45x.h"
+
+/* ★阶段2: 仅 App(RTOS) 构建里引入 FreeRTOS, 用于 TX 邮箱忙时让出 CPU。
+ *   Bootloader 不定义 FOC_APP_USE_RTOS -> 同一份源码仍可原样编译。 */
+#if defined(FOC_APP_USE_RTOS)
+#include "FreeRTOS.h"
+#include "task.h"
+#include "queue.h"
+#endif
+
+static uint8_t  s_node;
+static uint16_t s_dev_id;
+static uint16_t s_host_id;
+static uint16_t s_pdev_id;
+static uint16_t s_phost_id;
+
+static uint32_t s_rx_frames;
+static uint32_t s_rx_other;
+static uint32_t s_tx_fail;
+
+#if defined(FOC_APP_USE_RTOS)
+/* ★阶段2: 正在等 TX 邮箱的任务 (由 CAN2_TX 中断唤醒)。必须在文件靠前声明,
+ *   因为发送函数在下面的 RX 队列块之前。 */
+static volatile TaskHandle_t s_tx_waiter;
+#endif
+
+static uint32_t s_pclk1;
+static uint32_t s_presc;
+static uint32_t s_tq_total;
+
+/* ------------------------------------------------------------------ */
+/* GPIO: CAN2_RX = PB12 (上拉输入), CAN2_TX = PB13 (复用推挽)          */
+/* ------------------------------------------------------------------ */
+static void can_gpio_init(void)
+{
+    GPIO_InitType gpio;
+
+    RCC_EnableAPB2PeriphClk(RCC_APB2_PERIPH_AFIO | RCC_APB2_PERIPH_GPIOB, ENABLE);
+
+    GPIO_InitStruct(&gpio);
+    gpio.Pin       = GPIO_PIN_12;
+    gpio.GPIO_Mode = GPIO_Mode_IPU;
+    GPIO_InitPeripheral(GPIOB, &gpio);
+
+    gpio.Pin        = GPIO_PIN_13;
+    gpio.GPIO_Mode  = GPIO_Mode_AF_PP;
+    gpio.GPIO_Speed = GPIO_Speed_50MHz;
+    GPIO_InitPeripheral(GPIOB, &gpio);
+
+    /* CAN2_RMP = 00 (默认), 不需要 GPIO_ConfigPinRemap */
+}
+
+/* ------------------------------------------------------------------ */
+/* 位定时: 由 PCLK1 和目标波特率反算预分频 / BS1 / BS2                    */
+/*   bit time = (1 + BS1 + BS2) tq,  tq = presc / PCLK1                */
+/*   采样点尽量取 87.5%                                                  */
+/* ------------------------------------------------------------------ */
+static int can_bittiming(uint32_t pclk1, uint32_t baud, CAN_InitType* cfg)
+{
+    uint32_t presc;
+
+    if ((pclk1 == 0u) || (baud == 0u))
+    {
+        return -1;
+    }
+
+    for (presc = 1u; presc <= 1024u; presc++)
+    {
+        uint32_t div = baud * presc;
+        uint32_t tq_total;
+        uint32_t bs1;
+        uint32_t bs2;
+
+        if (div == 0u)
+        {
+            continue;
+        }
+        if ((pclk1 % div) != 0u)
+        {
+            continue;
+        }
+        tq_total = pclk1 / div;
+        if ((tq_total < 8u) || (tq_total > 25u))
+        {
+            continue;
+        }
+
+        bs2 = (tq_total + 4u) / 8u; /* 16tq -> 2tq, 20tq -> 3tq ... */
+        if (bs2 < 1u)
+        {
+            bs2 = 1u;
+        }
+        if (bs2 > 8u)
+        {
+            bs2 = 8u;
+        }
+        if (tq_total < (bs2 + 2u))
+        {
+            continue;
+        }
+        bs1 = tq_total - 1u - bs2;
+        if ((bs1 < 1u) || (bs1 > 16u))
+        {
+            continue;
+        }
+
+        cfg->BaudRatePrescaler = (uint16_t)presc;
+        cfg->TBS1              = (uint8_t)(bs1 - 1u); /* 编码: 0 => 1tq */
+        cfg->TBS2              = (uint8_t)(bs2 - 1u);
+        cfg->RSJW              = CAN_RSJW_1tq;
+
+        s_pclk1    = pclk1;
+        s_presc    = presc;
+        s_tq_total = tq_total;
+        return 0;
+    }
+    return -1;
+}
+
+void ota_can_set_ids(uint8_t node)
+{
+    s_node    = node;
+    s_dev_id   = (uint16_t)(OTA_CAN_ID_DEV_BASE + node);
+    s_host_id  = (uint16_t)(OTA_CAN_ID_HOST_BASE + node);
+    s_pdev_id  = (uint16_t)(OTA_CAN_ID_PDEV_BASE + node);
+    s_phost_id = (uint16_t)(OTA_CAN_ID_PHOST_BASE + node);
+}
+
+int ota_can_init(uint32_t baud, uint8_t node)
+{
+    RCC_ClocksType     clk;
+    CAN_InitType       ic;
+    CAN_FilterInitType fc;
+
+    ota_can_set_ids(node);
+    can_gpio_init();
+
+    RCC_EnableAPB1PeriphClk(RCC_APB1_PERIPH_CAN2, ENABLE);
+    CAN_DeInit(CAN2);
+
+    RCC_GetClocksFreqValue(&clk);
+
+    CAN_InitStruct(&ic);
+    if (can_bittiming(clk.Pclk1Freq, baud, &ic) != 0)
+    {
+        return -1;
+    }
+
+    ic.OperatingMode = CAN_Normal_Mode;
+    ic.TTCM          = DISABLE;
+    ic.ABOM          = ENABLE; /* 自动离线恢复: 总线抖动后能自己回来 */
+    ic.AWKUM         = DISABLE;
+    ic.NART          = DISABLE; /* 允许自动重传, 单帧可靠性优先 */
+    ic.RFLM          = DISABLE;
+    ic.TXFP          = ENABLE;
+
+    if (CAN_Init(CAN2, &ic) != CAN_InitSTS_Success)
+    {
+        return -2;
+    }
+
+    /* 两组硬件过滤器, 精确匹配两个通道的主机 ID, 并分进不同 FIFO:
+     *   bank0: OTA  通道 0x600+node -> FIFO0
+     *   bank1: 参数 通道 0x610+node -> FIFO1
+     * 标准帧 32 位掩码布局: STID[31:21], IDE[2], RTR[1]
+     * 好处: OTA 灌数据时不会把参数帧挤掉, 参数帧也不会混进 OTA 的帧计数。 */
+    {
+        uint32_t v0 = ((uint32_t)s_host_id << 21);
+        uint32_t v1 = ((uint32_t)s_phost_id << 21);
+        uint32_t mask = (0x7FFu << 21) | 0x06u; /* ID + IDE + RTR 全比对 */
+
+        fc.Filter_Mode  = CAN_Filter_IdMaskMode;
+        fc.Filter_Scale = CAN_Filter_32bitScale;
+        fc.Filter_Act   = ENABLE;
+
+        fc.Filter_Num        = 0u;
+        fc.Filter_HighId     = (uint16_t)(v0 >> 16);
+        fc.Filter_LowId      = (uint16_t)(v0 & 0xFFFFu);
+        fc.FilterMask_HighId = (uint16_t)(mask >> 16);
+        fc.FilterMask_LowId  = (uint16_t)(mask & 0xFFFFu);
+        fc.Filter_FIFOAssignment = CAN_Filter_FIFO0;
+        CAN2_InitFilter(&fc);
+
+        fc.Filter_Num        = 1u;
+        fc.Filter_HighId     = (uint16_t)(v1 >> 16);
+        fc.Filter_LowId      = (uint16_t)(v1 & 0xFFFFu);
+        fc.FilterMask_HighId = (uint16_t)(mask >> 16);
+        fc.FilterMask_LowId  = (uint16_t)(mask & 0xFFFFu);
+        fc.Filter_FIFOAssignment = CAN_Filter_FIFO1;
+        CAN2_InitFilter(&fc);
+        const uint16_t native_ids[]={0x081u,0x101u,0x401u,0x481u};
+        for(unsigned i=0;i<4u;i++) {
+            uint32_t v=(uint32_t)native_ids[i]<<21;
+            fc.Filter_Num=(uint8_t)(2u+i);
+            fc.Filter_HighId=(uint16_t)(v>>16);fc.Filter_LowId=(uint16_t)v;
+            CAN2_InitFilter(&fc);
+        }
+    }
+
+    return 0;
+}
+
+static int can_send_on(uint16_t id, const uint8_t* data, uint8_t len)
+{
+    CanTxMessage tx;
+    uint8_t      i;
+    uint32_t     guard;
+
+    if (len > 8u)
+    {
+        len = 8u;
+    }
+
+    tx.StdId = (uint32_t)id;
+    tx.ExtId = 0u;
+    tx.IDE   = (uint8_t)CAN_Standard_Id;
+    tx.RTR   = (uint8_t)CAN_RTRQ_Data;
+    tx.DLC   = len;
+    for (i = 0u; i < 8u; i++)
+    {
+        tx.Data[i] = (i < len) ? data[i] : 0u;
+    }
+
+    /* ★阶段2: 邮箱满时不再纯空转 4096 次 ——
+     *   调度器已启动时用 taskYIELD() 让出 CPU (其它任务得以运行), 并统计失败;
+     *   guard 仍然保留作为"有界"上限, 超时放弃由上位机超时重发兜底。
+     *   注: 本函数只在任务上下文调用 (协议/遥测发送), 不在 ISR 里调用。 */
+    /* ★阶段2: 邮箱满时【等 TX 完成通知】(有界 2ms/次, 最多 8 次), 不再靠
+     *   4096 次空转/让出试探。TME 中断只在等待窗口内使能, 避免中断风暴。
+     *   Bootloader(无调度器)仍走原来的有界重试。 */
+    for (guard = 0u; guard < 8u; guard++)
+    {
+        if (CAN_TransmitMessage(CAN2, &tx) != CAN_TxSTS_NoMailBox)
+        {
+            return 0;
+        }
+#if defined(FOC_APP_USE_RTOS)
+        if (xTaskGetSchedulerState() == taskSCHEDULER_RUNNING)
+        {
+            s_tx_waiter = xTaskGetCurrentTaskHandle();
+            CAN_INTConfig(CAN2, CAN_INT_TME, ENABLE);
+            (void)ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(2));   /* 等邮箱腾出来 */
+            CAN_INTConfig(CAN2, CAN_INT_TME, DISABLE);
+            s_tx_waiter = 0;
+        }
+#endif
+    }
+    s_tx_fail++;
+    return -1;
+}
+
+int ota_can_send(const uint8_t* data, uint8_t len)
+{
+    return can_send_on(s_dev_id, data, len);
+}
+
+int ota_can_send_param(const uint8_t* data, uint8_t len)
+{
+    return can_send_on(s_pdev_id, data, len);
+}
+
+#if defined(FOC_APP_USE_RTOS)
+/* ===================================================================
+ * ★阶段2: CAN RX 事件化
+ *   问题: 原来靠主循环轮询 CAN FIFO —— RTOS 化后 poll 任务降到 1ms 一轮,
+ *         而 500kbps 下约 4.5 帧/ms, 硬件 FIFO 只有 3 级 -> 必然溢出丢帧,
+ *         OTA 会退化成不停重传(阶段1 实测轮询明显变慢就是这个原因)。
+ *   做法: 打开 FIFO0/FIFO1 的"报文挂起"中断, ISR 里把帧搬进【有界静态队列】,
+ *         协议任务再用 ota_can_rxq_recv() 有界取走。
+ *   优先级: CAN2_RX0/RX1 设为 6 (>= configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY=5),
+ *         所以 ISR 里可以合法调用 ...FromISR。
+ * =================================================================== */
+#define OTA_CAN_RXQ_LEN   24u      /* 覆盖突发; 满了计数丢弃, 由 OTA 块重传兜底 */
+
+typedef struct
+{
+    uint8_t d[8];
+    uint8_t len;
+    uint8_t chan;      /* 0 = OTA 通道(0x600/0x580), 1 = 参数通道(0x610/0x590) */
+} ota_can_rxitem_t;
+
+static QueueHandle_t  s_rxq;
+static StaticQueue_t  s_rxq_ctrl;
+static uint8_t        s_rxq_buf[OTA_CAN_RXQ_LEN * sizeof(ota_can_rxitem_t)];
+static volatile uint32_t s_isr_frames;
+static volatile uint32_t s_isr_drop;
+
+int ota_can_rxq_init(void)
+{
+    if (s_rxq != 0)
+    {
+        return 0;                       /* 幂等 */
+    }
+    s_rxq = xQueueCreateStatic(OTA_CAN_RXQ_LEN, sizeof(ota_can_rxitem_t),
+                               s_rxq_buf, &s_rxq_ctrl);
+    if (s_rxq == 0)
+    {
+        return -1;
+    }
+
+    /* 两个 FIFO 都要中断: FIFO0 = OTA 通道, FIFO1 = 参数通道 (与过滤器分配一致) */
+    CAN_INTConfig(CAN2, CAN_INT_FMP0, ENABLE);
+    CAN_INTConfig(CAN2, CAN_INT_FMP1, ENABLE);
+
+    NVIC_SetPriority(CAN2_RX0_IRQn, 6u);
+    NVIC_SetPriority(CAN2_RX1_IRQn, 6u);
+    NVIC_EnableIRQ(CAN2_RX0_IRQn);
+    NVIC_EnableIRQ(CAN2_RX1_IRQn);
+
+    /* ★阶段2: TX 邮箱空中断 —— 只在"等邮箱"时才使能(TME 会被反复置位,
+     *   常开等于中断风暴), 所以这里只开 NVIC, 中断使能在等待处开关。 */
+    NVIC_SetPriority(CAN2_TX_IRQn, 6u);
+    NVIC_EnableIRQ(CAN2_TX_IRQn);
+    return 0;
+}
+
+/* 两个 FIFO 共用的搬运逻辑; ISR 里只做"取帧 + 入队", 不解析协议、不格式化 */
+static void ota_can_rx_isr(uint8_t fifo)
+{
+    BaseType_t     hpw = pdFALSE;
+    CanRxMessage   rx;
+    uint16_t       want = (fifo == CAN_FIFO0) ? s_host_id : s_phost_id;
+    uint8_t        chan = (fifo == CAN_FIFO0) ? 0u : 1u;
+    uint32_t       guard = 0u;
+
+    /* 有界: 一次中断最多搬 8 帧, 避免在 ISR 里久留 */
+    while ((CAN_PendingMessage(CAN2, fifo) != 0u) && (guard < 8u))
+    {
+        guard++;
+        CAN_ReceiveMessage(CAN2, fifo, &rx);      /* 内部已释放 FIFO */
+        s_isr_frames++;
+
+        if(rx.IDE==(uint8_t)CAN_Standard_Id && rx.RTR==(uint8_t)CAN_RTRQ_Data && rx.DLC==8u &&
+           motor_bench_rx_isr((uint16_t)rx.StdId,rx.Data))continue;
+        if ((rx.IDE == (uint8_t)CAN_Standard_Id) && (rx.RTR == (uint8_t)CAN_RTRQ_Data) &&
+            (rx.StdId == (uint32_t)want))
+        {
+            ota_can_rxitem_t it;
+            uint8_t          i;
+
+            for (i = 0u; i < 8u; i++)
+            {
+                it.d[i] = rx.Data[i];
+            }
+            it.len  = (rx.DLC > 8u) ? 8u : (uint8_t)rx.DLC;
+            it.chan = chan;
+
+            if (xQueueSendFromISR(s_rxq, &it, &hpw) != pdTRUE)
+            {
+                s_isr_drop++;      /* 队列满: 计数, 由 OTA 块重传兜底 */
+            }
+        }
+        else
+        {
+            s_rx_other++;
+        }
+    }
+    portYIELD_FROM_ISR(hpw);
+}
+
+void CAN2_RX0_IRQHandler(void)
+{
+    ota_can_rx_isr(CAN_FIFO0);
+}
+
+void CAN2_RX1_IRQHandler(void)
+{
+    ota_can_rx_isr(CAN_FIFO1);
+}
+
+/* 协议任务用: 有界取一帧; wait=0 表示不阻塞 */
+int ota_can_rxq_recv(uint8_t* data, uint8_t* len, uint8_t* chan, uint32_t wait_ticks)
+{
+    ota_can_rxitem_t it;
+    uint8_t          i;
+
+    if ((s_rxq == 0) || (data == 0) || (len == 0) || (chan == 0))
+    {
+        return 0;
+    }
+    if (xQueueReceive(s_rxq, &it, (TickType_t)wait_ticks) != pdTRUE)
+    {
+        return 0;
+    }
+    for (i = 0u; i < 8u; i++)
+    {
+        data[i] = it.d[i];
+    }
+    *len  = it.len;
+    *chan = it.chan;
+    s_rx_frames++;
+    return 1;
+}
+
+uint32_t ota_can_isr_frames(void) { return s_isr_frames; }
+uint32_t ota_can_isr_drop(void)   { return s_isr_drop; }
+uint32_t ota_can_rxq_len(void)    { return (s_rxq != 0) ? (uint32_t)uxQueueMessagesWaiting(s_rxq) : 0u; }
+
+/* ★阶段2: TX 完成(邮箱空)中断 -> 唤醒正在等邮箱的任务, 让发送不再空转 */
+void CAN2_TX_IRQHandler(void)
+{
+    CAN_ClearINTPendingBit(CAN2, CAN_INT_TME);
+    if (s_tx_waiter != 0)
+    {
+        BaseType_t hpw = pdFALSE;
+        vTaskNotifyGiveFromISR((TaskHandle_t)s_tx_waiter, &hpw);
+        portYIELD_FROM_ISR(hpw);
+    }
+}
+#endif /* FOC_APP_USE_RTOS */
+
+int ota_can_poll(uint8_t* data, uint8_t* len, uint8_t* chan)
+{
+    CanRxMessage rx;
+    uint8_t      i;
+    uint8_t      fifo;
+    uint16_t     want;
+
+    if (CAN_PendingMessage(CAN2, CAN_FIFO0) != 0u)
+    {
+        fifo  = CAN_FIFO0;
+        want  = s_host_id;
+        *chan = 0u;
+    }
+    else if (CAN_PendingMessage(CAN2, CAN_FIFO1) != 0u)
+    {
+        fifo  = CAN_FIFO1;
+        want  = s_phost_id;
+        *chan = 1u;
+    }
+    else
+    {
+        return 0;
+    }
+
+    /* 注意: 该函数内部已经释放 FIFO, 不要再调用 CAN_ReleaseFIFO */
+    CAN_ReceiveMessage(CAN2, fifo, &rx);
+
+    if ((rx.IDE != (uint8_t)CAN_Standard_Id) || (rx.RTR != (uint8_t)CAN_RTRQ_Data) ||
+        (rx.StdId != (uint32_t)want))
+    {
+        s_rx_other++;
+        return 0;
+    }
+
+    for (i = 0u; i < 8u; i++)
+    {
+        data[i] = rx.Data[i];
+    }
+    *len = (rx.DLC > 8u) ? 8u : rx.DLC;
+    s_rx_frames++;
+    return 1;
+}
+
+uint32_t ota_can_rx_frames(void)
+{
+    return s_rx_frames;
+}
+
+uint32_t ota_can_rx_other(void)
+{
+    return s_rx_other;
+}
+
+uint32_t ota_can_tx_fail(void)
+{
+    return s_tx_fail;
+}
+
+uint32_t ota_can_prescaler(void)
+{
+    return s_presc;
+}
+
+uint32_t ota_can_tq_total(void)
+{
+    return s_tq_total;
+}
+
+uint32_t ota_can_pclk1(void)
+{
+    return s_pclk1;
+}
+
+int ota_can_try_send_native(uint16_t id,const uint8_t data[8])
+{
+    CanTxMessage tx;
+    tx.StdId=id;tx.ExtId=0;tx.IDE=CAN_Standard_Id;tx.RTR=CAN_RTRQ_Data;tx.DLC=8;
+    for(unsigned i=0;i<8;i++)tx.Data[i]=data[i];
+    return CAN_TransmitMessage(CAN2,&tx)==CAN_TxSTS_NoMailBox?-1:0;
+}
