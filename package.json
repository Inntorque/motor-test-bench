{
  "name": "inntorque-motor-test-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "hardware": "python3 -m workbench.service",
    "build": "vite build",
    "postbuild": "node scripts/build_gateway_icons.mjs && node scripts/build_browser.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:requirements": "node tests/requirements-ui.mjs",
    "start": "node scripts/launch.mjs start",
    "stop": "node scripts/launch.mjs stop",
    "test:maximum-ui": "node tests/maximum-ui.mjs",
    "build:gateway-icons": "node scripts/build_gateway_icons.mjs",
    "test:gateway-icons": "node tests/gateway-icons-ui.mjs",
    "build:browser": "node scripts/build_browser.mjs",
    "test:browser": "node --test tests/browser-legacy.mjs tests/browser-legacy-control.mjs && node tests/browser-ui.mjs && node tests/bootloader-ui.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "three": "0.187.0",
    "vite": "8.3.4"
  }
}
