{
  "name": "inntorque-motor-test-bench",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run desktop:start",
    "build": "vite build",
    "postbuild": "node scripts/build_desktop.mjs",
    "prebuild": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "pretest": "npm run typecheck",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:ui": "node tests/layout-performance-ui.mjs --desktop",
    "test:desktop": "node tests/desktop-ui.mjs",
    "desktop:setup": "npm ci --prefix desktop && node desktop/node_modules/electron/install.js",
    "desktop:start": "npm --prefix desktop start",
    "desktop:build": "npm run build && npm --prefix desktop run package",
    "desktop:install": "npm --prefix desktop run install:linux",
    "release:local": "npm run build && node scripts/release.mjs",
    "protocol:check": "node scripts/check_protocol.mjs",
    "review:upload": "node scripts/review_upload.mjs",
    "test:portable": "node tests/portable-update-ui.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-serial": "1.0.9",
    "@types/w3c-web-usb": "1.0.14",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
