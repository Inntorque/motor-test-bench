{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "types": [
      "react",
      "react-dom",
      "w3c-web-usb",
      "w3c-web-serial"
    ],
    "strict": false,
    "erasableSyntaxOnly": true,
    "isolatedModules": true
  },
  "include": [
    "browser/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "gateway/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "site",
    "dist",
    ".runtime",
    "gateway/hosts"
  ]
}
