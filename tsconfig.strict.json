{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "useUnknownInCatchVariables": false,
    "types": [
      "w3c-web-usb"
    ]
  },
  "include": [
    "gateway/ui/bootloader/**/*.ts",
    "gateway/standby/**/*.ts",
    "browser/bytes.ts",
    "browser/types.ts",
    "browser/messages.ts",
    "browser/events.ts",
    "web/src/frameBuffer.ts",
    "web/src/encoderBins.ts"
  ],
  "exclude": [
    "node_modules",
    "site",
    "dist",
    ".runtime"
  ]
}
